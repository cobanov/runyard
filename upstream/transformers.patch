+class RunyardCallback(TrainerCallback):
+    """
+    A [`TrainerCallback`] that logs metrics to [runyard](https://github.com/cobanov/runyard), a lightweight
+    self-hosted training tracker. One run per training: its config is the [`TrainingArguments`] plus the model
+    config, its name is `run_name`, and metrics are keyed by the global step. Run status, stdout/stderr and GPU usage
+    are recorded by runyard itself.
+
+    Environment:
+    - **RUNYARD_SERVER** (`str`, *optional*, defaults to `"http://localhost:8080"`):
+        Address of the runyard server.
+    - **RUNYARD_API_KEY** (`str`):
+        API key that lets this process write runs, created on the server with `runyard-server key create <name>`.
+    - **RUNYARD_PROJECT** (`str`, *optional*):
+        Project the run belongs to.
+    """
+
+    # logged once at the end of training; they go to the run's summary instead of its charts
+    single_value_scalars = (
+        "train_runtime",
+        "train_samples_per_second",
+        "train_steps_per_second",
+        "train_loss",
+        "total_flos",
+    )
+
+    def __init__(self):
+        if not is_runyard_available():
+            raise RuntimeError("RunyardCallback requires runyard to be installed. Run `pip install runyard`.")
+        import runyard
+
+        self._runyard = runyard
+        self._run = None
+
+    def setup(self, args, state, model):
+        """
+        Starts the run on the main process. Configure the server, API key and project through the environment
+        variables above.
+        """
+        if self._run is not None or not state.is_world_process_zero:
+            return
+        config = args.to_dict()
+        model_config = getattr(model, "config", None)
+        if model_config is not None:
+            config["model"] = model_config if isinstance(model_config, dict) else model_config.to_dict()
+        self._run = self._runyard.init(name=args.run_name, config=config)
+
+    def on_train_begin(self, args, state, control, model=None, **kwargs):
+        self.setup(args, state, model)
+
+    def on_log(self, args, state, control, logs=None, **kwargs):
+        if self._run is None or not logs:
+            return
+        self._run.summary.update({k: v for k, v in logs.items() if k in self.single_value_scalars})
+        values = rewrite_logs({k: v for k, v in logs.items() if k not in self.single_value_scalars})
+        if values:
+            self._run.log(values, step=state.global_step)
+
+
