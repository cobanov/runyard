+class RunyardCallbackTest(unittest.TestCase):
+    def _create_callback(self, fake_runyard):
+        with patch("transformers.integrations.integration_utils.is_runyard_available", return_value=True):
+            with patch.dict("sys.modules", {"runyard": fake_runyard}):
+                return RunyardCallback()
+
+    def test_logs_metrics_by_step_and_end_of_training_scalars_to_summary(self):
+        fake_runyard = Mock()
+        run = fake_runyard.init.return_value
+        run.summary = {}
+        callback = self._create_callback(fake_runyard)
+        args = SimpleNamespace(run_name="runyard-run", to_dict=lambda: {"learning_rate": 1e-3})
+        model = SimpleNamespace(config=SimpleNamespace(to_dict=lambda: {"hidden_size": 8}))
+
+        callback.on_train_begin(args, SimpleNamespace(is_world_process_zero=True), None, model=model)
+        state = SimpleNamespace(is_world_process_zero=True, global_step=10)
+        callback.on_log(args, state, None, logs={"loss": 0.5, "eval_loss": 0.4})
+        callback.on_log(args, state, None, logs={"train_runtime": 1.5, "train_loss": 0.45})
+
+        fake_runyard.init.assert_called_once_with(
+            name="runyard-run", config={"learning_rate": 1e-3, "model": {"hidden_size": 8}}
+        )
+        run.log.assert_called_once_with({"train/loss": 0.5, "eval/loss": 0.4}, step=10)
+        self.assertEqual(run.summary, {"train_runtime": 1.5, "train_loss": 0.45})
+
+    def test_only_main_process_starts_a_run(self):
+        fake_runyard = Mock()
+        callback = self._create_callback(fake_runyard)
+        args = SimpleNamespace(run_name=None, to_dict=lambda: {})
+
+        callback.on_train_begin(args, SimpleNamespace(is_world_process_zero=False), None, model=None)
+        callback.on_log(args, SimpleNamespace(is_world_process_zero=False, global_step=1), None, logs={"loss": 1.0})
+
+        fake_runyard.init.assert_not_called()
+
